# ─── App ────────────────────────────────────────────────────────────────
# Public base URL used to build invite links. Must be https:// in production.
APP_URL=http://localhost:3000

# 32+ random bytes, base64 or hex. Signs session cookies and encrypts the
# host's copy of the invite token. Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Hours a room stays alive after creation (default 12, max 24).
ROOM_TTL_HOURS=12

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgres://closeby:closeby@localhost:5432/closeby

# ─── Redis (optional) ───────────────────────────────────────────────────
# When set, rate limits are shared across app instances. When unset an
# in-process limiter is used (fine for a single instance).
# REDIS_URL=redis://localhost:6379

# ─── LiveKit ────────────────────────────────────────────────────────────
# Server-side API credentials (never exposed to the browser).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# HTTP(S) URL the app server uses for the LiveKit Room Service API.
LIVEKIT_API_URL=http://127.0.0.1:7880
# WebSocket URL the browser connects to. Must be wss:// in production.
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# ─── Ops ────────────────────────────────────────────────────────────────
# Bearer secret for POST /api/cron/cleanup (expired-room cleanup).
CRON_SECRET=replace-me

# Multiplies all rate limits. Leave at 1 in production (used by the E2E suite).
# RATE_LIMIT_SCALE=1
